# Configure hosted values using Sites environment settings, then redeploy.
SOLANA_RPC_URL=https://api.mainnet.solana.com
ADMIN_EMAILS=

# Server-only. Requires licensed Benzinga News API access; never expose in client code.
BENZINGA_API_KEY=

# Optional dedicated GeckoTerminal onchain access through CoinGecko Pro.
# Server-only; requires a subscription with this endpoint. Configure in Sites, then redeploy.
COINGECKO_PRO_API_KEY=
